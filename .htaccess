Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<FilesMatch "^(?:\.env|.*\.log)$">
  Require all denied
</FilesMatch>

# Editor, interne Bearbeitungsparameter und nicht anonymisierte Pilotquellen
# dürfen bei einem produktiven Apache-Deployment nicht extern erreichbar sein.
<FilesMatch "^(?:bildausschnitt-editor\.html|bildausschnitt-editor\.js|image-editor-config\.js|orig-001-(?:vor|nach)\.jpg)$">
  Require local
</FilesMatch>
